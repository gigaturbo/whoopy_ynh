#!/bin/bash

source _common.sh
source /usr/share/yunohost/helpers

#=================================================
# VALIDATION
#=================================================

# Validators run for changed fields only: ticking the box alone must check too.
validate__wol_enabled() {
    validate__wol_mac
}

# The panel's pattern takes 300.1.1.1; the wake daemon would refuse to start.
validate__wol_broadcast() {
    python3 -I -c 'import ipaddress, sys; ipaddress.IPv4Address(sys.argv[1])' "${wol_broadcast:-}" 2>/dev/null \
        || echo "Not an IPv4 address, e.g. 255.255.255.255 or 192.168.1.255."
}

validate__wol_mac() {
    if [ "${wol_enabled:-0}" = "1" ] && [ -z "${wol_mac:-}" ]; then
        echo "A MAC address is needed to wake the Ollama machine."
    fi
}

# The list lands in nginx's config: one address or network per entry.
validate__lan_ranges() {
    whoopy_lan_allow "${lan_ranges:-}" >/dev/null \
        || echo "Addresses or networks separated by spaces, e.g. 192.168.0.0/16 fd00::/8."
}

# Turning the shared login off with no personal admin account would lock
# everyone out of the admin page.
validate__env_login() {
    [ "${env_login:-1}" = "0" ] || return 0
    local admins
    admins=$(ynh_psql_db_shell <<< "SELECT count(*) FROM \"LiteLLM_UserTable\" WHERE user_role = 'proxy_admin' AND password IS NOT NULL;" \
        | sed -n 's/^ *\([0-9][0-9]*\) *$/\1/p' | head -n1)
    if [ "${admins:-0}" = "0" ]; then
        echo "Create your own admin account with a password in LiteLLM's admin page first (Users, role Admin), then turn this off."
    fi
}

#=================================================
# GETTERS
#=================================================

# The status line above the Wake button, from the wake daemon.
get__wake_status() {
    local out
    out=$(timeout 5 "$install_dir/bin/whoopy" --socket "/run/$app/wake.sock" status 2>&1) \
        || out="The wake daemon does not answer: systemctl status $app-wake"
    echo "ask: |"
    sed 's/^/    - /' <<< "$out"
}

#=================================================
# SETTERS
#=================================================

# Never shown, kept only when a new one is typed.
set__ui_password() {
    set +o xtrace
    if [ -n "${ui_password:-}" ]; then
        ynh_app_setting_set --key=ui_password --value="$ui_password"
    fi
    set -o xtrace
}

#=================================================
# APPLY
#=================================================

ynh_app_config_apply() {
    _ynh_app_config_apply

    # The templates read these, and they may have just changed.
    ollama_url=$(ynh_app_setting_get --key=ollama_url)
    keep_alive=$(ynh_app_setting_get --key=keep_alive)
    wol_enabled=$(ynh_app_setting_get --key=wol_enabled)
    wol_mac=$(ynh_app_setting_get --key=wol_mac)
    wol_broadcast=$(ynh_app_setting_get --key=wol_broadcast)
    wake_timeout_s=$(ynh_app_setting_get --key=wake_timeout_s)
    outbound=$(ynh_app_setting_get --key=outbound)
    lan_ranges=$(ynh_app_setting_get --key=lan_ranges)
    env_login=$(ynh_app_setting_get --key=env_login)
    set +o xtrace
    ui_password=$(ynh_app_setting_get --key=ui_password)
    set -o xtrace

    whoopy_configure
    whoopy_start
}

#=================================================
# ACTIONS
#=================================================

run__wake_now() {
    # The daemon wakes with the saved settings, and shares the wake with any
    # request already waiting for it.
    local out
    if out=$("$install_dir/bin/whoopy" --socket "/run/$app/wake.sock" wake 2>&1); then
        ynh_print_info "$out"
    else
        ynh_die "$out"
    fi
}

run__new_master_key() {
    # In an action, a field not in the button's section holds its old value,
    # and for the bind = "null" secrets that is the YNH_NULL marker: read
    # them from the settings.
    outbound=$(ynh_app_setting_get --key=outbound)
    lan_ranges=$(ynh_app_setting_get --key=lan_ranges)
    set +o xtrace
    ui_password=$(ynh_app_setting_get --key=ui_password)
    master_key="sk-$(ynh_string_random --length=48)"
    ynh_app_setting_set --key=master_key --value="$master_key"
    set -o xtrace
    whoopy_configure
    whoopy_start
    ynh_print_info "New master key saved. It is in $install_dir/whoopy.env (root only)."
}

ynh_app_config_run "$1"
