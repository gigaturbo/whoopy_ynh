#!/bin/bash

source _common.sh
source /usr/share/yunohost/helpers

#=================================================
# VALIDATION
#=================================================

# The list lands in nginx's config: one address or network per entry.
validate__lan_ranges() {
    whoopy_lan_allow "${lan_ranges:-}" >/dev/null \
        || echo "Addresses or networks separated by spaces, e.g. 192.168.0.0/16 fd00::/8."
}

# The names land in nginx's config: server names only.
validate__mcp_public() {
    whoopy_mcp_public_re "${mcp_public:-}" >/dev/null \
        || echo "MCP server names separated by spaces, e.g. web docs."
}

# Turning the shared login off with no personal admin account would lock
# everyone out of the admin page.
validate__env_login() {
    [ "${env_login:-1}" = "0" ] || return 0
    local admins
    admins=$(ynh_psql_db_shell <<< "SELECT count(*) FROM \"LiteLLM_UserTable\" WHERE user_role = 'proxy_admin' AND password IS NOT NULL;" \
        | sed -n 's/^ *\([0-9][0-9]*\) *$/\1/p' | head -n1)
    if [ "${admins:-0}" = "0" ]; then
        echo "Create your own admin account with a password in LiteLLM's admin page first (Users, role Admin), then turn this off."
    fi
}

#=================================================
# SETTERS
#=================================================

# Never shown, kept only when a new one is typed.
set__ui_password() {
    set +o xtrace
    if [ -n "${ui_password:-}" ]; then
        ynh_app_setting_set --key=ui_password --value="$ui_password"
    fi
    set -o xtrace
}

#=================================================
# APPLY
#=================================================

ynh_app_config_apply() {
    _ynh_app_config_apply

    # The templates read these, and they may have just changed.
    ollama_url=$(ynh_app_setting_get --key=ollama_url)
    outbound=$(ynh_app_setting_get --key=outbound)
    lan_ranges=$(ynh_app_setting_get --key=lan_ranges)
    mcp_public=$(ynh_app_setting_get --key=mcp_public)
    env_login=$(ynh_app_setting_get --key=env_login)
    set +o xtrace
    ui_password=$(ynh_app_setting_get --key=ui_password)
    set -o xtrace

    whoopy_configure
    whoopy_start
}

#=================================================
# ACTIONS
#=================================================

run__new_master_key() {
    # In an action, a field not in the button's section holds its old value,
    # and for the bind = "null" secrets that is the YNH_NULL marker: read
    # them from the settings.
    outbound=$(ynh_app_setting_get --key=outbound)
    lan_ranges=$(ynh_app_setting_get --key=lan_ranges)
    mcp_public=$(ynh_app_setting_get --key=mcp_public)
    set +o xtrace
    ui_password=$(ynh_app_setting_get --key=ui_password)
    master_key="sk-$(ynh_string_random --length=48)"
    ynh_app_setting_set --key=master_key --value="$master_key"
    set -o xtrace
    whoopy_configure
    whoopy_start
    ynh_print_info "New master key saved. It is in $install_dir/whoopy.env (root only)."
}

ynh_app_config_run "$1"
