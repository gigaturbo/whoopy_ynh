#!/bin/bash

source _common.sh
source /usr/share/yunohost/helpers

for service in "$app" "$app-wake"; do
    if ynh_hide_warnings yunohost service status "$service" >/dev/null; then
        yunohost service remove "$service"
    fi
done

ynh_config_remove_systemd
ynh_config_remove_systemd "$app-wake"
ynh_config_remove_nginx
# The loopback table: the file for the next boot, the table for now.
ynh_safe_rm "/etc/nftables.d/$app.conf"
nft delete table inet "$app" 2>/dev/null || true
# The wake settings, which systemd keeps after the unit goes.
ynh_safe_rm "/var/lib/$app"

# The install dir, data dir, database, user and Node version go with the
# manifest's resources.

ynh_script_progression "Removal of $app completed"
