#!/bin/bash

source _common.sh
source /usr/share/yunohost/helpers

whoopy_default_settings

# The web search and documents settings, dropped in 0.2.0~ynh5: such
# servers are added in LiteLLM's admin page now. Untraced: two are tokens.
set +o xtrace
for key in search_enabled search_url search_token docs_enabled docs_url docs_embed_url docs_token; do
    ynh_app_setting_delete --key="$key"
done
set -o xtrace

# Rebuilt only when the lock file or uv changed: the pin moves only with a
# new package version (see RISKS R35 on the server).
rebuild=1
if [ -x "$install_dir/venv/bin/litellm" ] \
    && [ "$(whoopy_build_fingerprint)" = "${build_fingerprint:-}" ]; then
    rebuild=0
else
    whoopy_check_downloads
fi

ynh_script_progression "Stopping LiteLLM..."
ynh_systemctl --service="$app" --action="stop"
if [ -e "/etc/systemd/system/$app-wake.service" ]; then
    ynh_systemctl --service="$app-wake" --action="stop"
fi

if [ "$rebuild" = 1 ]; then
    ynh_script_progression "Reinstalling LiteLLM from the locked wheels..."
    whoopy_install_code
    whoopy_build_venv
fi
whoopy_install_binary

ynh_script_progression "Updating configuration files..."
whoopy_configure
whoopy_set_logo

ynh_script_progression "Starting LiteLLM (pending database migrations run now)..."
whoopy_start

ynh_script_progression "Upgrade of $app completed"
