# Written by the Yunohost scripts. Mode 600 root: systemd reads it before
# dropping privilege. Never move these into Environment= lines of the unit:
# `systemctl show` hands those to any local account.

DATABASE_URL=postgresql://__DB_USER__:__DB_PWD__@127.0.0.1:5432/__DB_NAME__
LITELLM_MASTER_KEY=__MASTER_KEY__
# Encrypts the provider credentials stored in the database. Never change it:
# a new salt makes every stored credential unreadable.
LITELLM_SALT_KEY=__SALT_KEY__
UI_USERNAME=admin
# Swagger moves off /, which is Whoopy's status page.
DOCS_URL=/docs
UI_PASSWORD="__UI_PASSWORD_ENV__"

# Read by whoopy_wake.py: which requests go to Ollama, whether to wake for
# them at all, and how long one may wait for the wake daemon (wake.env holds
# the rest).
WHOOPY_OLLAMA_URL=__OLLAMA_URL__
WHOOPY_WOL_ENABLED=__WOL_ENABLED__
WHOOPY_WAKE_TIMEOUT_S=__WAKE_TIMEOUT_S__

# Sent to the wake daemon's MCP server (config.yaml, mcp_servers: whoopy).
WHOOPY_MCP_TOKEN=__MCP_TOKEN__
