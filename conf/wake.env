# Written by the Yunohost scripts, read by whoopy-wake.service. Mode 600
# root: systemd reads it before dropping privilege.

WHOOPY_OLLAMA_URL=__OLLAMA_URL__
WHOOPY_WOL_ENABLED=__WOL_ENABLED__
WHOOPY_WOL_MAC=__WOL_MAC__
WHOOPY_WOL_BROADCAST=__WOL_BROADCAST__
WHOOPY_WAKE_TIMEOUT_S=__WAKE_TIMEOUT_S__

# The status page on loopback, proxied by nginx at / and /whoopy/.
WHOOPY_WEB_PORT=__PORT_WEB__
WHOOPY_WEB_PAGE=__INSTALL_DIR__/web/index.html

# The MCP server on loopback; LiteLLM sends the same token (whoopy.env).
WHOOPY_MCP_PORT=__PORT_MCP__
WHOOPY_MCP_TOKEN=__MCP_TOKEN__
